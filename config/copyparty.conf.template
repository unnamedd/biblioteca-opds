# /etc/copyparty.conf  --  rendered by scripts/30-copyparty.sh
#
# Three doors onto one library (nothing is duplicated on disk):
#
#   /                 a plain landing page, visible to anyone
#   /<BOOKS_ENDPOINT>     reading + OPDS. Read-only for EVERYONE, you included.
#   /<MANAGER_ENDPOINT>   upload / rename / delete. You only.
#
# The paths are configurable in library.env precisely so that a stock install
# of this open-source project is not guessable.
#
# Bare lines are boolean flags; "key: value" lines take an argument.
# Reference: https://copyparty.eu/cli/

[global]
  # listen port. 80 keeps the URL free of a port number; the systemd unit
  # grants CAP_NET_BIND_SERVICE so copyparty can bind it without being root.
  p: __PORT__

  # shown top-left in the web UI and over mDNS
  name: __LIBRARY_TITLE__

  # enable the OPDS feed (off by default). Reachable as <volume>/?opds
  opds

  # NOTE: the format list is NOT set here. Each volume carries its own
  # "opds_exts" volflag below, so the book catalogue lists book formats and
  # the wallpaper catalogue lists images, with no chance of the two bleeding
  # into each other.

  # cover thumbnails. While no-thumb is set the OPDS feed still emits cover
  # links, but with an empty href, so the reader shows no covers.
  # Turning them on needs one thumbnail backend: copyparty lists epub under
  # both --th-r-pil (pillow) and --th-r-ffi (ffmpeg), so either will do.
  # Pi OS Lite ships neither; python3-pil is much the smaller of the two.
  # Each cover is decoded once and cached under hist, not per request.
  # Set ENABLE_COVERS=1 in library.env to turn them on.
__THUMB_LINE__

  # up2k index: powers search and dedup. Cheap, worth having.
  e2d

  # --- keep it off the radar -------------------------------------------
  # the server is reachable from the public internet through Funnel
  no-robots

  # --- administrative endpoints: off -----------------------------------
  # each of these is a link copyparty otherwise offers every visitor under
  # a heading called "other stuff:". Disabling them here means the endpoint
  # itself refuses, not merely that the link is hidden.
  no-ups-page          # ?ru          "show recent uploads"
  no-stack             # ?stack       thread dump
  no-rescan            # ?scan        reindex
  no-reload            # ?reload=cfg  reload users/volumes
  no-up-list           # incoming-file list in the control panel
  ups-who: 0           # nobody sees the recent-uploads page
  du-who: no           # stop telling visitors "N GiB free of M GiB"
  ver-who: no          # do not advertise the copyparty version
  zip-who: 1           # only admins may tar/zip the whole library

  # --- books only: no audio/video machinery ----------------------------
  no-acode             # no audio transcoding
  no-athumb            # no spectrograms
  no-vthumb            # no video thumbnails
  no-mtag-ff           # no ffprobe media tagging
  no-logues            # do not render .prologue/.epilogue.html from the books folder
  no-readme            # ...nor README.md

  # Cosmetic only: hides the dead links the flags above leave behind.
  # "#cc" is the "other stuff:" heading, ".agr" the link block, "#v" connect.
  # The markup still exists in the page source -- the flags above are what
  # actually protects; this only keeps the UI clean.
  html-head: <style>#cc,.agr,#v{display:none!important}</style>

  # Tailscale Funnel and Cloudflare Tunnel both terminate TLS and proxy from
  # localhost, setting X-Forwarded-For. Trust exactly that one hop (xff-src).
  #
  # rproxy: -1 attributes a request to the RIGHTMOST X-Forwarded-For entry:
  # the one appended by the proxy nearest to us, i.e. the real client. Tested
  # against copyparty: with 1 (leftmost) a client can seed the header and
  # dodge ban-pw by changing the seed; with a header NAME that does not match
  # what the proxy sends, every request looks like 127.0.0.1 and one wrong
  # password bans everybody. -1 is correct for both tunnels; inert with none.
  #
  # xff-src must cover BOTH loopback families. cloudflared reaches copyparty
  # at "localhost", which on the Pi resolves to ::1 as readily as 127.0.0.1;
  # tailscaled uses 127.0.0.1. A peer outside xff-src has its forwarded
  # headers ignored: browser logins then fail the CSRF check ("rejected by
  # cors-check"), and ban-pw keys on the loopback address - i.e. on everyone
  # behind that tunnel. Loopback only, so a LAN client forging headers is
  # still ignored. These two ranges are copyparty's own default.
  xff-hdr: x-forwarded-for
  xff-src: 127.0.0.0/8, ::1/128
  rproxy: -1

__BAN_PW_LINE__

[accounts]
__ACCOUNTS_LINES__

__VOLUMES__
