# /etc/copyparty.conf  --  rendered by scripts/30-copyparty.sh
#
# Serves __BOOKS_DIR__ as:
#   - an OPDS catalogue for the Xteink reader   ->  /books/?opds
#   - a browser upload UI for your phone        ->  /books/
#
# Bare lines are boolean flags; "key: value" lines take an argument.
# Reference: https://copyparty.eu/cli/

[global]
  # listen port. 80 keeps the URL free of a port number; the systemd unit
  # grants CAP_NET_BIND_SERVICE so copyparty can bind it without being root.
  p: __PORT__

  # enable the OPDS feed (off by default). Reachable as <volume>/?opds
  opds

  # cover thumbnails. While no-thumb is set the OPDS feed still emits cover
  # links, but with an empty href, so the reader shows no covers.
  # Turning them on needs one thumbnail backend: copyparty lists epub under
  # both --th-r-pil (pillow) and --th-r-ffi (ffmpeg), so either will do.
  # Pi OS Lite ships neither; python3-pil is much the smaller of the two.
  # Each cover is decoded once and cached under hist, not per request.
  # Set ENABLE_COVERS=1 in library.env to turn them on.
__THUMB_LINE__

  # up2k index: powers search and dedup. Cheap, worth having.
  e2d

  # keep the index/db out of the books folder itself.
  hist: /var/lib/copyparty/hist

  # Tailscale Serve/Funnel terminates TLS and proxies from localhost,
  # setting X-Forwarded-{For,Proto,Host}. Trust exactly that one hop.
  xff-hdr: x-forwarded-for
  xff-src: 127.0.0.1
  rproxy: 1

__BAN_PW_LINE__

[accounts]
__ACCOUNTS_LINES__

[/books]
  __BOOKS_DIR__
  accs:
    # r=read w=upload m=move/rename d=delete. Without "d" the web UI and
    # WebDAV both answer 403 "'delete' not allowed"; without "m" you cannot
    # rename either. Use "A" instead for rwmda. (adds admin + dotfiles).
    # Set GUEST_ACCOUNT in library.env to add a second, read-only account:
    # friends sign in with their own password, browse and download the whole
    # library, and cannot upload, rename or delete anything.
__ACCS_LINES__
  flags:
    opds
