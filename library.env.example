# Copy to library.env and edit. library.env is gitignored - it holds the password.
#
#   cp library.env.example library.env
#
# Anything left blank falls back to the default shown.

# mDNS name published on the LAN -> http://biblioteca.local
LIBRARY_ALIAS=biblioteca

# copyparty account used by both the reader (OPDS) and your phone (uploads).
COPYPARTY_ACCOUNT=reader

# Leave blank and 30-copyparty.sh generates a strong one, prints it once,
# and writes it back here.
COPYPARTY_PASSWORD=

# 80 keeps the URL free of a port number. Change only if something else owns :80.
COPYPARTY_PORT=80

# Where the .epub files live on the Pi.
BOOKS_DIR=/srv/books

# Unprivileged system user that runs copyparty.
SERVICE_USER=copyparty

# 1 = install zram swap (recommended on a 512 MB board), 0 = skip.
ENABLE_ZRAM=1

# 1 = extract EPUB cover thumbnails for the OPDS catalogue. Needs one
#     thumbnail backend - pillow or ffmpeg both work; 10-system.sh installs
#     python3-pil, the smaller of the two. Each cover is decoded once and
#     cached, not rebuilt per request. With 0 the reader shows no covers -
#     the catalogue is filename-based either way.
ENABLE_COVERS=0

# 1 = keep copyparty's brute-force ban (9 bad passwords/hour -> 24 h ban).
# 0 = disable it, which is safer while you are still typing the password
#     into the reader by hand. Set back to 1 once everything works.
BAN_PW=1

# Used only by deploy.sh on the Mac: where to rsync + ssh.
# Before the .local alias exists, use the Pi's current name or IP.
PI_SSH=pi@raspberrypi.local
