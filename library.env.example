# 📚 Biblioteca — configuration
#
#   cp library.env.example library.env
#
# library.env is gitignored: it holds your passwords. Anything left blank
# falls back to the default shown here.
#
# ┌─ CHANGE THESE FIRST ──────────────────────────────────────────────────┐
# │ BOOKS_ENDPOINT, MANAGER_ENDPOINT and WALLPAPERS_ENDPOINT become the   │
# │ URLs your server answers on. Biblioteca is open source, so the stock  │
# │ layout is public knowledge — picking your own names means a scanner   │
# │ that knows this project finds nothing at the obvious addresses.       │
# │ It is obscurity on top of the passwords, never instead of them.       │
# └───────────────────────────────────────────────────────────────────────┘


# ─── Library ─────────────────────────────────────────────────────────────

# Your library's name. Shown on the landing page, in the browser title, and
# top-left in the web UI. Yours to choose — the footer credits stay put.
#
# Quote it if it contains spaces or an apostrophe. This file is read as a
# shell script, so LIBRARY_TITLE=Your Name's Shelf is a syntax error and
# LIBRARY_TITLE=My Library silently becomes empty. The installer checks for
# both and tells you, but quoting simply always works:
#     LIBRARY_TITLE="Your Name's Shelf"
LIBRARY_TITLE="Biblioteca"


# ─── Server ──────────────────────────────────────────────────────────────

# Published over mDNS on the LAN  ->  http://biblioteca.local
SERVER_HOSTNAME=biblioteca

# 80 keeps every URL free of a port number. Change only if something else
# already owns :80 — then every address below gains ":<port>".
SERVER_PORT=80

# Unprivileged unix account the server runs as.
SERVICE_USER=copyparty


# ─── Management door ─────────────────────────────────────────────────────
# Upload, rename, delete. Yours alone.
#     https://<server>:<port>/manager/
# Wallpapers are managed one level in, at /manager/wallpapers/

MANAGER_ENDPOINT=manager

# The account that owns the library.
MANAGER_ACCOUNT=reader

# Leave blank and 30-copyparty.sh generates a strong one, prints it once,
# and writes it back into library.env.
MANAGER_PASSWORD=


# ─── Guests ──────────────────────────────────────────────────────────────
# An optional second account: read-only for friends. They get their own
# password, browse and download the whole library (no copies, no separate
# folder), and cannot upload, rename or delete anything. Blank = no guest.

GUEST_ACCOUNT=

# Blank + a GUEST_ACCOUNT set -> generated, printed once, saved back here.
GUEST_PASSWORD=

# copyparty's brute-force ban: 9 wrong passwords in an hour -> 24 h ban.
# 0 disables it, which helps while you are still typing the password into
# the reader by hand. Set back to 1 once everything works.
BAN_PW=1


# ─── Books ───────────────────────────────────────────────────────────────
# Reading and OPDS. Read-only for EVERYONE, you included — that is what
# makes your view identical to your guests'.
#     https://<server>:<port>/books/           browser
#     https://<server>:<port>/books/?opds      the reader
# Changing this means re-entering the OPDS URL on the reader once.

BOOKS_ENDPOINT=books

# Where the files live on disk (not a URL — that is BOOKS_ENDPOINT above).
BOOKS_DIR=/srv/books

# Which formats appear in the catalogue. The reader itself opens only
# epub, xtc/xtch and txt; the rest download fine but are meant for reading
# on a phone or computer.
BOOKS_EXTS=epub,xtc,xtch,txt,pdf,md,cbz,cbr,azw3,mobi,fb2

# 1 = extract EPUB cover thumbnails. Needs one thumbnail backend — pillow
# or ffmpeg both work, and 10-system.sh installs python3-pil, the smaller
# of the two. Each cover is decoded once and cached, not per request.
ENABLE_COVERS=0


# ─── Wallpapers ──────────────────────────────────────────────────────────
# CrossPoint sleep-screen images, kept out of the book catalogue entirely.
# Add this as a SECOND OPDS server on the reader:
#     https://<server>:<port>/wallpapers/      browser
#     https://<server>:<port>/wallpapers/?opds the reader
# The installer creates the folder; you do not need to.

WALLPAPERS_ENABLED=1
WALLPAPERS_ENDPOINT=wallpapers
WALLPAPERS_DIR=/srv/wallpapers

# What the device can actually open as a sleep screen. BMP wants exact
# dimensions — 480x800 on the X4, 528x792 on the X3. PXC is CrossPoint's
# native format and about a tenth the size, which matters over Funnel.
# PNG is deliberately absent: the reader cannot open a standalone PNG, so
# listing one would only produce an entry that fails when tapped. PNGs you
# drop in WALLPAPERS_DIR are still visible and downloadable from a browser.
WALLPAPERS_EXTS=bmp,pxc


# ─── Landing page ────────────────────────────────────────────────────────
# The public page at https://<server>:<port>/ — no login, nothing listed.
# Customise config/landing/index.html.template, not the copy on the Pi:
# the installer re-renders it on every run.

LANDING_DIR=/srv/landing


# ─── System ──────────────────────────────────────────────────────────────

# 1 = install zram swap. Recommended on a 512 MB board.
ENABLE_ZRAM=1


# ─── Deploying from your computer ────────────────────────────────────────

# Used only by deploy.sh: where to rsync and ssh.
# Before the .local name exists, use the Pi's current hostname or IP.
PI_SSH=pi@raspberrypi.local
